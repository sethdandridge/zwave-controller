# Copy to /etc/zwave-controller/secrets.env on the VM; chmod 600.

ZWAVE_WS_URL=ws://192.168.20.20:3002
KEYPAD_NODE_ID=2

UNIFI_HOST=https://192.168.1.1
UNIFI_SITE=default
UNIFI_API_KEY=paste-api-key-from-unifi-os-admin-panel
UNIFI_POLICY_ID=paste-firewall-policy-uuid
UNIFI_VERIFY_TLS=false

DISARM_PIN=1234
LOG_LEVEL=INFO

# --- Notifications (optional) ---------------------------------------------
# Unset NTFY_URL disables all door/motion/health alerts. The topic name IS
# the password on ntfy.sh -- use a long random string, e.g.
#   python3 -c 'import secrets; print("zw-" + secrets.token_urlsafe(24))'
#NTFY_URL=https://ntfy.sh/zw-CHANGE-ME-long-random-topic
#NTFY_TOKEN=                       # only for protected/self-hosted instances
#NOTIFY_COOLDOWN_SECONDS=300       # motion, and offline/online flap damping
#NOTIFY_DOOR_COOLDOWN_SECONDS=15   # doors/tamper: short, so a follow-in still alerts
#NOTIFY_MOTION=true                # set false to mute the motion sensor
#NOTIFY_BATTERY_THRESHOLD=20       # percent

# --- Presence (optional, needs NTFY_URL) -----------------------------------
# Door/motion alerts are muted while any of these MACs is on the WiFi.
# Tamper, battery and offline alerts still fire. Take the MAC from the UniFi
# client list, and keep iOS "Private Wi-Fi Address" set to Fixed for this SSID.
#PRESENCE_MACS=3e:90:21:a9:71:a2    # comma-separated
#PRESENCE_POLL_SECONDS=30           # how often to ask UniFi (min 5)
#PRESENCE_AWAY_GRACE_SECONDS=300    # unseen this long before alerts resume
